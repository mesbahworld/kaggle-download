# Kaggle API credentials
# Get yours from https://www.kaggle.com/settings -> "Create New API Token"
#
# Option A: username + key (legacy)
KAGGLE_USERNAME=your_username_here
KAGGLE_KEY=your_api_key_here

# Option B: token-based credential (KGAT_...)
# Uncomment and use this instead of the two above if you prefer.
# KAGGLE_API_TOKEN=KGAT_your_token_here

# Where to download datasets. Resolved relative to the project root if
# it is a relative path. Defaults to ./data when unset.
DOWNLOAD_DIR=./data
